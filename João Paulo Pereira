body {
  background-color: #f0f8ff; /* azul claro */
  font-family: 'Poppins', sans-serif;
  color: #333;
  text-align: center;
  margin-top: 50px;
}

h1 {
  color: #2e8b57; /* verde */
}

p {
  font-size: 18px;
}

img {
  border-radius: 15px;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
}


